<Window x:Class="AgentUI.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AgentUI — Feedback" Width="860" Height="620" MinWidth="660" MinHeight="460"
        Background="#F6F5F0" Foreground="#25342E" FontFamily="Segoe UI" FontSize="14"
        ShowActivated="False" WindowStartupLocation="Manual">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#25342E"/>
            <Setter Property="BorderBrush" Value="#CCD2C6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#486741"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#486741"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="#CCD2C6"/><Setter Property="Margin" Value="0,6,0,14"/><Setter Property="Background" Value="White"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,6,0,14"/><Setter Property="MinHeight" Value="38"/></Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Card" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="Background" Value="#DFE8D5"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#C4CDBB"/><Setter TargetName="Card" Property="BorderThickness" Value="1"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid Background="#F6F5F0">
        <Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
        <Border BorderBrush="#DDE0D6" BorderThickness="0,0,0,1" Padding="24,16">
            <DockPanel>
                <Button x:Name="PinButton" DockPanel.Dock="Right" Content="Pin panel" FontSize="12" Padding="10,6" Margin="0" Click="TogglePin" AutomationProperties.AutomationId="pin"/>
                <Button DockPanel.Dock="Right" Content="Connect" FontSize="12" Padding="10,6" Margin="0,0,8,0" Click="OpenSetup" AutomationProperties.AutomationId="connect"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#25342E" CornerRadius="7" Width="34" Height="34"><TextBlock Text="a" Foreground="#DFF39A" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,-3,0,0"/></Border>
                    <TextBlock Text="AgentUI" FontSize="21" FontWeight="SemiBold" Margin="12,0,16,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Your agents, one inbox." Foreground="#626C61" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border BorderBrush="#DDE0D6" BorderThickness="0,0,1,0" Padding="14,22,14,10">
                <DockPanel>
                    <TextBlock x:Name="QueueHeading" Text="YOUR INBOX" DockPanel.Dock="Top" FontSize="11" FontWeight="SemiBold" Foreground="#626C61" Margin="10,0,0,16"/>
                    <ListBox x:Name="Inbox" Background="Transparent" BorderThickness="0" SelectionChanged="SelectRequest" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="inbox"/>
                </DockPanel>
            </Border>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="Body" Margin="30,25,30,24"/>
            </ScrollViewer>
        </Grid>
        <Border Grid.Row="2" BorderBrush="#DDE0D6" BorderThickness="0,1,0,0" Padding="24,10">
            <TextBlock x:Name="Footer" Text="On your device · no web server" Foreground="#626C61" FontSize="12" AutomationProperties.AutomationId="status"/>
        </Border>
    </Grid>
</Window>
