{
  "tools": [
    {
      "annotations": {
        "destructiveHint": false,
        "openWorldHint": false
      },
      "description": "Register work/roles/repo; get answers and Board matches.",
      "inputSchema": {
        "properties": {
          "clear_repo": {
            "type": "boolean"
          },
          "cwd": {
            "type": "string"
          },
          "doing": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          },
          "requested_owner": {
            "type": "string"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "maxItems": 12,
            "type": "array"
          }
        },
        "type": "object"
      },
      "name": "desk_register"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "openWorldHint": false
      },
      "description": "Ask Artem what files cannot settle; defaults only if reversible.",
      "inputSchema": {
        "properties": {
          "body": {
            "type": "string"
          },
          "deadline": {
            "type": "string"
          },
          "dedupe_key": {
            "type": "string"
          },
          "default": {
            "description": "Recommended option or form values"
          },
          "evidence": {
            "items": {
              "properties": {
                "label": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              },
              "required": [
                "label",
                "url"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "fields": {
            "items": {
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "options": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "required": {
                  "type": "boolean"
                },
                "type": {
                  "enum": [
                    "text",
                    "number",
                    "boolean",
                    "choice"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "id",
                "label",
                "type"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "handle": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "choose",
              "approve",
              "text",
              "form",
              "inform"
            ],
            "type": "string"
          },
          "options": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "p0_reason": {
            "type": "string"
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ],
            "type": "string"
          },
          "reversible": {
            "type": "boolean"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "title",
          "default",
          "deadline",
          "reversible"
        ],
        "type": "object"
      },
      "name": "desk_ask"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Read answers at checkpoints. Silence is never yes.",
      "inputSchema": {
        "properties": {
          "before": {
            "type": "string"
          },
          "delivery_id": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "ids": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "wait_ms": {
            "maximum": 600000,
            "minimum": 0,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "name": "desk_answers"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "openWorldHint": false
      },
      "description": "Withdraw an ask.",
      "inputSchema": {
        "properties": {
          "handle": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "name": "desk_cancel"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "openWorldHint": false
      },
      "description": "Relay only: list; mark after delivery. Page next as before.",
      "inputSchema": {
        "properties": {
          "action": {
            "enum": [
              "list",
              "mark"
            ],
            "type": "string"
          },
          "ask_id": {
            "type": "string"
          },
          "before": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "owners": {
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "type": "array"
          },
          "to": {
            "description": "Delivered session id or \"notes\"",
            "type": "string"
          }
        },
        "required": [
          "action"
        ],
        "type": "object"
      },
      "name": "desk_relay"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "See agents/roles/work; next as after. Inactive is opt-in.",
      "inputSchema": {
        "properties": {
          "after": {
            "minimum": 0,
            "type": "integer"
          },
          "handle": {
            "type": "string"
          },
          "include_inactive": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "name": "board_who"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "openWorldHint": false
      },
      "description": "Message role/owner/public agent ID/everyone. Thread/dedupe retries.",
      "inputSchema": {
        "properties": {
          "body": {
            "type": "string"
          },
          "dedupe_key": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "references": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "thread": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "to": {
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "everyone",
                  "role",
                  "agent",
                  "owner"
                ]
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          }
        },
        "required": [
          "title",
          "body"
        ],
        "type": "object"
      },
      "name": "board_post"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Read routed/sent messages; nonconsuming. Page with next as after.",
      "inputSchema": {
        "properties": {
          "after": {
            "minimum": 0,
            "type": "integer"
          },
          "handle": {
            "type": "string"
          },
          "thread": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "board_read"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "openWorldHint": false
      },
      "description": "Create/list/get/cancel handoffs; dedupe, ten open per owner.",
      "inputSchema": {
        "properties": {
          "action": {
            "enum": [
              "request",
              "requests",
              "get",
              "cancel"
            ]
          },
          "after": {
            "minimum": 0,
            "type": "integer"
          },
          "beads_issue": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "dedupe_key": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "include_closed": {
            "type": "boolean"
          },
          "paths": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "repo": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "to_role": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "board_request"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "openWorldHint": false
      },
      "description": "Claim; save fence. Handle calls renew live claims; fence for release.",
      "inputSchema": {
        "properties": {
          "action": {
            "enum": [
              "claim",
              "renew",
              "release"
            ]
          },
          "fence": {
            "minimum": 1,
            "type": "integer"
          },
          "handle": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "name": "board_claim"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "openWorldHint": false
      },
      "description": "Finish with fence; failed:true reports failure.",
      "inputSchema": {
        "properties": {
          "failed": {
            "type": "boolean"
          },
          "fence": {
            "minimum": 1,
            "type": "integer"
          },
          "handle": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "result": {
            "description": "Record supplied results verbatim, preserving limits and qualifiers.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "fence",
          "result"
        ],
        "type": "object"
      },
      "name": "board_done"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "openWorldHint": false
      },
      "description": "Check PR/merge overlaps; unknown is not clear. Manage own holds.",
      "inputSchema": {
        "properties": {
          "action": {
            "enum": [
              "list",
              "check",
              "acquire",
              "release"
            ]
          },
          "after": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "paths": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "repo": {
            "type": "string"
          },
          "stage": {
            "enum": [
              "pr_open",
              "merge"
            ]
          }
        },
        "required": [
          "action"
        ],
        "type": "object"
      },
      "name": "work_holds"
    }
  ]
}
