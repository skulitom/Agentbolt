{
  "name": "agentui",
  "version": "0.1.0",
  "description": "Interactive UIs for coding agents — an MCP server that lets any agent ask its human with sliders, forms, diffs and live previews.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "agentui": "dist/cli.js",
    "agentui-mcp": "dist/mcp.js"
  },
  "files": [
    "dist",
    "web",
    "skill",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-ui.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/mcp.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "nanoid": "^6.0.1",
    "open": "^11.0.0",
    "smol-toml": "^1.4.2",
    "ws": "^8.21.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@agentui/shared": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
